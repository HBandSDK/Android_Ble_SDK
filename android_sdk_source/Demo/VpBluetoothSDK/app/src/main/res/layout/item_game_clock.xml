<?xml version="1.0" encoding="utf-8"?>
<!--
    时段列表条目：圆角卡片 + 时段信息 + 独立开关。
    点击整行进入编辑，右滑删除。

    三种视觉状态（由 GameClockAdapter 切换背景与标签）：
      普通    —— 白底 + 灰色 id 徽章
      编辑中  —— 浅蓝底 + 2dp 蓝描边 + 蓝色 id 徽章 + 「编辑中」标签
      刚新增  —— 暖橙底 + 2dp 橙描边 + 橙色 id 徽章 + 「新增」标签
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vBg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_game_clock_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="11dp"
    android:paddingEnd="12dp"
    android:paddingBottom="11dp">

    <TextView
        android:id="@+id/tvClockId"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_game_clock_id"
        android:gravity="center"
        android:text="1"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvClockTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00 - 12:30"
                android:textColor="#212121"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_game_clock_badge_editing"
                android:paddingStart="5dp"
                android:paddingTop="1dp"
                android:paddingEnd="5dp"
                android:paddingBottom="1dp"
                android:text="编辑中"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvClockDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="每天 · 星期重复 · 30 分钟"
            android:textColor="#8A8A8A"
            android:textSize="12sp" />
    </LinearLayout>

    <com.github.iielse.switchbutton.SwitchView
        android:id="@+id/svClockOpen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
