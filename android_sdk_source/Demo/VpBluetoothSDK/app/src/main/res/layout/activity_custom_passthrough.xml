<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/vTitle"
        layout="@layout/layout_title_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/svCmdList"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/text_info_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vTitle">

        <TextView
            android:id="@+id/tvCmdList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textColor="#fff"
            android:textSize="14sp" />
    </ScrollView>

    <Button
        android:id="@+id/btnAddCmd"
        style="@style/vpButton"
        android:layout_width="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnDeleteCmd"
        app:layout_constraintHorizontal_weight="1"
        android:text="添加指令"
        app:layout_constraintTop_toBottomOf="@id/svCmdList" />

    <Button
        android:id="@+id/btnDeleteCmd"
        style="@style/vpButton"
        android:text="删除最后指令"
        android:layout_width="0dp"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnAddCmd"
        app:layout_constraintTop_toBottomOf="@id/svCmdList" />

    <Button
        android:id="@+id/btnClearCmd"
        style="@style/vpButton"
        android:text="清空指令"
        android:layout_width="0dp"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnClearLog"
        app:layout_constraintTop_toBottomOf="@id/btnAddCmd" />

    <Button
        android:id="@+id/btnClearLog"
        style="@style/vpButton"
        android:text="清空日志"
        android:layout_width="0dp"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnClearCmd"
        app:layout_constraintTop_toBottomOf="@id/btnAddCmd" />

    <Button
        android:id="@+id/btnSend"
        style="@style/vpButton"
        android:text="发送全部指令"
        app:layout_constraintTop_toBottomOf="@id/btnClearCmd" />

    <ScrollView
        android:id="@+id/svTestInfo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/text_info_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSend">

        <TextView
            android:id="@+id/tvTestInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="#fff"
            android:textSize="14sp" />
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
